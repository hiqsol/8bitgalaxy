#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["markdown", "uwiki @ git+https://github.com/hiqsol/uwiki@v0.2.0"]
# ///
"""Check the docs wiki: generic checks by uwiki, then frontmatter, numbered rules, technology catalog.

Usage: bin/checkdocs  (exits 1 on problems, uv installs dependencies)
"""

import os
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

import markdown
import uwiki

ROOT = Path(__file__).resolve().parent.parent
PATHS = ['docs', 'ideas']
FILES = sorted(f for p in PATHS for f in (ROOT / p).glob('**/*.md'))
KEYS = {'status', 'scope', 'aliases', 'date', 'updated'}
CLASSES = {'M': 'Military', 'C': 'Culture', 'P': 'Production', 'S': 'Science'}
TECH_DIRS = ('TechnologyActions', 'TechnologyModifiers', 'Hubs')
TECH_BASES = {'TechnologyAction', 'TechnologyModifier', 'Hub'}
KIND_TECH = {'Action': 'TechnologyAction', 'Modifier': 'TechnologyModifier',
             'Social Hub': 'Hub', 'Industrial Hub': 'Hub', 'Research Hub': 'Hub'}
FACTIONS = {'Player', 'Galaxy'}
# catalog item: Name: LevelClasses - Kind - Types - Factions - Scope, then a description
TECH_ITEM = re.compile(r'[^:]+: (?P<levels>.+?) - (?P<kind>.+?) - (?P<types>.+?)'
                       r' - (?P<factions>.+?) - (?P<scope>\S+)(?: |$)')
LEVEL_CLASSES = re.compile(r'(\d+)([mcps]+)$')
# folder: kind pages the first rule links
KINDS = {
    'BasicActions': {'BasicAction'},
    'TechnologyActions': {'TechnologyAction'},
    'TechnologyModifiers': {'TechnologyModifier'},
    'Hubs': {'Hub'},
    'Cards': {'Type'},
    'Properties': {'Property', 'Trait'},
    'Resources': {'Resource', 'Power'},
    'States': {'State'},
    'Types': {'Class', 'Origin', 'Role'},
    'Home': {'Home'},
}
KIND_PAGES = {'BasicAction', 'TechnologyAction', 'TechnologyModifier', 'Hub', 'Card', 'Deck', 'Property', 'Resource', 'State', 'Home'}
CLASS_TECH = re.compile(r'\[\[(%s)\]\] technolog|technology Level' % '|'.join(CLASSES.values()))

problems = []


def report(path, msg):
    problems.append(f'{path.relative_to(ROOT)}: {msg}')


class Page:
    def __init__(self, path):
        md = markdown.Markdown(extensions=['meta', 'tables', 'wikilinks'],
                               extension_configs={'wikilinks': {'build_url': lambda label, base, end: label}})
        self.path = path
        self.text = path.read_text()
        self.tree = ET.fromstring(f'<div>{md.convert(self.text)}</div>')
        self.meta = {k: ' '.join(v) for k, v in md.Meta.items()}

    def table(self):
        """Rows of the first table as lists of cells, without header."""
        return [list(tr) for tr in self.tree.iter('tr')][1:]

    def items(self, heading):
        """Top-level items of the numbered list under a heading."""
        children = list(self.tree)
        start = next(i for i, e in enumerate(children) if ''.join(e.itertext()) == heading)
        return next(e for e in children[start:] if e.tag == 'ol').findall('li')

    def section(self, heading):
        """Code values of the list under a heading."""
        return {c.text for li in self.items(heading) for c in li.iter('code')}


def text(element):
    return ''.join(element.itertext()).strip()


def links(element):
    return [a.get('href') for a in element.iter('a')]


def top_rules(page):
    """Top-level numbered rules, each without its nested lists."""
    ol = page.tree.find('ol')
    result = []
    for li in [] if ol is None else ol.findall('li'):
        rule = ET.Element('li')
        rule.text = li.text
        rule.extend(child for child in li if child.tag not in ('ol', 'ul'))
        result.append(rule)
    return result


def check_templates(pages):
    for page in pages.values():
        folder = page.path.parent.name
        if folder not in KINDS or page.path.stem in KIND_PAGES or page.meta.get('status') == 'stub':
            continue
        rules = top_rules(page)
        if not rules or not KINDS[folder] & set(links(rules[0])):
            report(page.path, f'first rule must link {" or ".join(sorted(KINDS[folder]))}')
        if folder == 'Cards':
            role = next((r for r in rules if text(r).startswith('Role =')), None)
            need = ['Role =', 'Origin =']
            if role is not None and {'Unit', 'Actor', 'Structure'} & set(links(role)):
                need += ['Range =', 'Size =', 'Capacity =']
            for prefix in need:
                if not any(text(r).startswith(prefix) for r in rules):
                    report(page.path, f'card type needs a rule "{prefix} ..."')


def check_page(page, statuses, scopes):
    for key in page.meta.keys() - KEYS:
        report(page.path, f'unknown frontmatter key: {key}')
    for key, allowed in (('status', statuses), ('scope', scopes)):
        if page.meta.get(key) not in allowed:
            report(page.path, f'{key} not in docs/index.md: {page.meta.get(key)}')
    if page.meta.get('scope') != 'meta' and page.meta.get('status') != 'stub' and page.tree.find('ol') is None:
        report(page.path, 'no numbered rules')


def deck_assignments(deck):
    """Map technology -> {(card, end): class} from the Deck table."""
    result, card = {}, None
    for row in deck.table():
        card = text(row[0]) or card
        for tech in links(row[4]) + links(row[5]):
            result.setdefault(tech, {})[(card, text(row[1]))] = text(row[3])
    return result


def card_types(pages):
    """Card Types: the Cards pages whose first rule links Type."""
    return {p.path.stem for p in pages.values() if p.path.parent.name == 'Cards'
            and 'Type' in links(next(iter(top_rules(p)), ET.Element('li')))}


def check_technologies(pages):
    catalog, deck = pages['Technology'], pages['Deck']
    assigned = deck_assignments(deck)
    types = card_types(pages)
    # Hub actions (Create) are technologies via the hub
    cataloged = set(links(pages['Hub'].tree))

    for item in catalog.items('List'):
        tech, line = next(iter(links(item)), None), ' '.join(text(item).split())
        match = TECH_ITEM.match(line)
        if not tech or not match:
            report(catalog.path, f'not "Name: LevelClasses - Kind - Types - Factions - Scope": {line[:40]}')
            continue
        cataloged.add(tech)

        levels = set()
        for token in match['levels'].split():
            level = LEVEL_CLASSES.match(token)
            if level:
                levels |= {(int(level[1]), c.upper()) for c in level[2]}
            else:
                report(catalog.path, f'{tech}: LevelClasses like 2cp, not {token}')
        kind = KIND_TECH.get(match['kind'])
        if not kind:
            report(catalog.path, f'{tech}: kind {match["kind"]} not in {", ".join(KIND_TECH)}')
        listed_types = set(match['types'].split(', '))
        for name in sorted(listed_types - types):
            report(catalog.path, f'{tech}: {name} is not a card Type')
        for name in sorted(set(match['factions'].split(', ')) - FACTIONS):
            report(catalog.path, f'{tech}: {name} not in {", ".join(sorted(FACTIONS))}')

        page = pages.get(tech)
        if page and page.meta.get('scope') != match['scope']:
            report(catalog.path, f'{tech} scope {match["scope"]}, its page says {page.meta.get("scope")}')
        first = top_rules(page)[:1] if page else []
        if first and kind:
            named = set(links(first[0]))
            want = {CLASSES[c] for _, c in levels}
            if kind not in named or named & set(CLASSES.values()) != want:
                report(page.path, f'first rule must name {", ".join(sorted(want))} {kind}, as in [[Technology]]')

        # Deck cards must be listed, listed values without a card are intended
        for (card, end), cls in sorted(assigned.pop(tech, {}).items()):
            card_type, level = card.split()[0], int(re.search(r'\d+', card)[0])
            if (level, cls) not in levels:
                report(catalog.path, f'{tech}: missing {level}{cls.lower()} of {card} {end} from Deck')
            if card_type not in listed_types:
                report(catalog.path, f'{tech}: missing {card_type} of {card} {end} from Deck')

    for tech in sorted(assigned):
        report(deck.path, f'technology not in Technology list: {tech}')

    for page in pages.values():
        if page not in (catalog, deck) and CLASS_TECH.search(page.text):
            report(page.path, 'technology class or level belongs in [[Technology]] only')
        if page.path.parent.name in TECH_DIRS and page.path.stem not in TECH_BASES | cataloged:
            report(page.path, 'technology missing from [[Technology]] list')


def main():
    os.chdir(ROOT)
    problems.extend(uwiki.check(PATHS))  # links, images, frontmatter syntax, list numbering
    pages = {path.stem: Page(path) for path in FILES}
    statuses = pages['index'].section('Status')
    scopes = pages['index'].section('Scopes')

    for page in pages.values():
        check_page(page, statuses, scopes)
    check_technologies(pages)
    check_templates(pages)

    for line in problems:
        print(line)
    print(f'{len(FILES)} pages, {len(problems)} problems', file=sys.stderr)
    return 1 if problems else 0


if __name__ == '__main__':
    sys.exit(main())
