#!/usr/bin/env python3
"""Rewrap markdown lines longer than WIDTH (tab counts as 4).

Only paragraphs and list items containing an overlong line are rewrapped,
together with their continuation lines. Frontmatter, code blocks, tables
and headings are left as is. Wiki links and inline code are not split.
Usage: bin/wrapmd [-w WIDTH] FILE...
"""
import re
import sys

WIDTH = 70
TOKEN = re.compile(r'(?:\[\[[^\]]*\]\]|`[^`]*`|[^\s`\[]+|\[)+')
ITEM = re.compile(r'^(\t*)((?:[-*+]|\d+[.)]|>) +|[a-z]\) +)?')
BLOCK = re.compile(r'^\s*(?:[-*+>#|]|\d+[.)])(?:\s|$)')


def width(s):
    return len(s.expandtabs(4))


def is_plain(line):
    return line.strip() and not line.lstrip().startswith(('#', '|', '```'))


def wrap(head, cont, words):
    # Glue a word that would start a list or heading to the previous one
    glued = []
    for w in words:
        if glued and BLOCK.match(w + ' '):
            glued[-1] += ' ' + w
        else:
            glued.append(w)
    lines, cur = [], head
    for w in glued:
        sep = '' if cur in (head, cont) else ' '
        nxt = cur + sep + w
        if width(nxt) > WIDTH and cur not in (head, cont):
            lines.append(cur)
            cur = cont + w
        else:
            cur = nxt
    lines.append(cur)
    return lines


def process(text):
    src = text.split('\n')
    out, i, fence = [], 0, False
    if src and src[0] == '---':
        end = src.index('---', 1) + 1
        out, i = src[:end], end
    while i < len(src):
        line = src[i]
        if line.lstrip().startswith('```'):
            fence = not fence
        if fence or line.lstrip().startswith('```') or not is_plain(line):
            out.append(line)
            i += 1
            continue
        m = ITEM.match(line)
        head = line[:m.end()]
        cont = m.group(1) + (' ' * len(m.group(2)) if m.group(2) else '')
        if m.group(2) and m.group(2).startswith('>'):
            cont = m.group(1) + m.group(2)
        group = [line]
        j = i + 1
        while j < len(src) and is_plain(src[j]) and not ITEM.match(src[j]).group(2):
            nl = src[j]
            if cont and nl.startswith(cont) and not nl[len(cont):].startswith((' ', '\t')):
                group.append(nl)
            elif not cont and nl[:1].islower():
                group.append(nl)
            else:
                break
            j += 1
        if all(width(g) <= WIDTH for g in group):
            out.extend(group)
        else:
            words = TOKEN.findall(' '.join([line[m.end():]] + [g.strip() for g in group[1:]]))
            out.extend(wrap(head, cont, words))
        i = j
    return '\n'.join(out)


def main(args):
    global WIDTH
    if args[:1] == ['-w']:
        WIDTH, args = int(args[1]), args[2:]
    for path in args:
        with open(path) as f:
            text = f.read()
        new = process(text)
        if new != text:
            with open(path, 'w') as f:
                f.write(new)


if __name__ == '__main__':
    main(sys.argv[1:])
