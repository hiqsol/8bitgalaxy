{
  "name": "8bitgalaxy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "npm run dev -w @8bitgalaxy/client",
    "server": "npm run dev -w @8bitgalaxy/server",
    "build": "npm run build -w @8bitgalaxy/client",
    "test": "npm test -w @8bitgalaxy/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "cards": "npm run cards -w @8bitgalaxy/engine"
  }
}
