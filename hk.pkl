// 8bitgalaxy's lint for hk: devkit's steps (.config/devkit/hk-steps.pkl) and its own, hk settings.
amends ".config/devkit/hk-config.pkl"
import ".config/devkit/hk-steps.pkl" as devkit

fail_fast = false                         // report what every step finds, not the first one only

hooks = devkit.hooks((devkit.steps) {
  // status, scope and tags lists of uwiki.toml the same as meta/Docs.md and rules/index.md document them
  ["checkdocs"] {
    glob = List("**/*.md", "uwiki.toml")
    check = "bin/checkdocs"
  }
})
